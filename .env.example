# Backend (when running `go run ./cmd/api` against the compose database)
PORT=8080
DATABASE_URL=postgres://geofence:geofence@localhost:5432/geofence?sslmode=disable
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Empty = API key auth off
API_KEY=
# 0 = rate limiting off
RATE_LIMIT_RPS=0
# Alert on any restricted_zone entry even without a configured rule
RESTRICTED_ZONE_DEFAULT_ALERT=true

# docker compose host ports (change if 5432/8080 are taken)
DB_HOST_PORT=5432
API_HOST_PORT=8080
WEB_HOST_PORT=3000

# Frontend
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/alerts
