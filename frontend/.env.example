# Base URL of the Go API (no trailing slash)
VITE_API_URL=http://localhost:8080
# WebSocket endpoint; defaults to VITE_API_URL with http→ws + /ws/alerts when unset
VITE_WS_URL=ws://localhost:8080/ws/alerts
# Only if the backend sets API_KEY (sent as X-API-Key, and ?api_key= on the WebSocket)
VITE_API_KEY=
